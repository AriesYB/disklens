{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiskLens",
  "version": "0.3.0",
  "identifier": "com.disklens.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DiskLens 盘析 — 看清每一寸磁盘",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}