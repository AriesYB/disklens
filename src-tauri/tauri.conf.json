{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiskLens",
  "version": "1.0.0",
  "identifier": "com.disklens.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DiskLens 盘析 — 看清每一寸磁盘",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4N0I5MTUzQTBFM0YwRUIKUldUcjhPT2dVNUY3Mk5VcWhUeXlCSDNRQVZvQ2ZaQ0UzMUdaV29YSjRKY2lNS0N4Z3M4b28vNTYK",
      "endpoints": [
        "https://ikanp.top/downloads/disklens/latest.json",
        "https://github.com/AriesYB/disklens/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
